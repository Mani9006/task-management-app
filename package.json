{
  "name": "task-management-system",
  "version": "1.0.0",
  "description": "A full-stack task management application with React frontend and Express backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "client:start": "cd client && npm start",
    "client:build": "cd client && npm run build",
    "lint": "eslint src/ tests/ client/src/",
    "lint:fix": "eslint src/ tests/ client/src/ --fix",
    "simulate-commits": "node simulate_commits.js"
  },
  "keywords": [
    "task-management",
    "kanban",
    "productivity",
    "react",
    "express",
    "nodejs"
  ],
  "author": "Mani <myfamily9006@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 70,
        "lines": 70
      }
    }
  }
}
